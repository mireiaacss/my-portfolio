---
import SectionHeading from './SectionHeading.astro';
import { useI18n } from '../i18n';

const { t } = useI18n(Astro.currentLocale);
---

<section id="skills" aria-labelledby="skills-title" class="shell border-t border-rule-strong py-16 md:py-24">
  <div class="grid gap-10 md:grid-cols-12 md:gap-8">
    <SectionHeading index="03" id="skills-title" title={t.skills.title} />

    <div class="md:col-span-9">
      <dl class="grid gap-x-10 sm:grid-cols-2">
        {
          t.skills.groups.map((s, i) => (
            <div class="reveal group border-t border-rule py-6">
              <dt class="label flex items-baseline gap-3">
                <span class="tabular-nums text-accent">{String(i + 1).padStart(2, '0')}</span>
                <span class="transition-colors duration-150 group-hover:text-ink">{s.group}</span>
              </dt>
              <dd class="mt-3">
                <ul class="flex flex-wrap gap-x-1 gap-y-1.5 leading-snug">
                  {s.items.map((item, j) => (
                    <li>
                      {item}
                      {j < s.items.length - 1 && (
                        <span class="px-1.5 text-rule" aria-hidden="true">
                          /
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="reveal mt-10 border-t border-rule-strong pt-5">
        <h3 class="label">{t.skills.spokenTitle}</h3>
        <ul class="mt-3 flex flex-wrap gap-x-8 gap-y-2">
          {
            t.skills.languages.map((l) => (
              <li>
                <span class="font-display text-xl">{l.name}</span>{' '}
                <span class="font-mono text-xs text-faint">{l.level}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
