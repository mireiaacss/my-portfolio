---
import SectionHeading from './SectionHeading.astro';
import { experience, education } from '../data/profile';
import { useI18n, formatMonth } from '../i18n';

const { locale, t } = useI18n(Astro.currentLocale);
const jobs = experience.map((job, i) => ({ ...job, ...t.experience.items[i] }));
---

<section id="experience" aria-labelledby="experience-title" class="shell border-t border-rule-strong py-16 md:py-24">
  <div class="grid gap-10 md:grid-cols-12 md:gap-8">
    <SectionHeading index="01" id="experience-title" title={t.experience.title} />

    <div class="md:col-span-9">
      {
        jobs.map((job) => (
          <article class="reveal grid gap-3 border-b border-rule py-8 first:pt-0 sm:grid-cols-[10rem_1fr] sm:gap-8">
            <p class="font-mono text-xs text-faint tabular-nums">
              <time datetime={job.start}>{formatMonth(job.start, locale)}</time> –{' '}
              <time datetime={job.end}>{formatMonth(job.end, locale)}</time>
            </p>
            <div>
              <h3 class="font-display text-2xl leading-tight tracking-[-0.01em]">{job.role}</h3>
              <p class="mt-1 text-sm text-muted">
                <span class="font-medium text-ink">{job.org}</span> · {job.context} · {job.location}
              </p>
              <ul class="mt-5 space-y-3 text-[0.95rem] leading-relaxed">
                {job.bullets.map((b) => (
                  <li class="relative pl-5 before:absolute before:left-0 before:top-[0.7em] before:h-px before:w-2.5 before:bg-accent">
                    {b}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }

      <aside aria-labelledby="education-title" class="reveal mt-12 grid gap-8 bg-sunken p-6 sm:grid-cols-2 md:p-8">
        <div>
          <h3 id="education-title" class="label">{t.experience.educationTitle}</h3>
          <p class="mt-3 font-display text-xl leading-snug">{t.experience.degree}</p>
          <p class="mt-2 text-sm text-muted">{t.experience.school}</p>
          <p class="mt-1 font-mono text-xs text-faint tabular-nums">
            <time datetime={education.start}>{formatMonth(education.start, locale)}</time> –{' '}
            <time datetime={education.end}>{formatMonth(education.end, locale)}</time>
          </p>
          <p class="mt-4 text-sm leading-relaxed text-muted">{t.experience.coursework.join(' · ')}</p>
        </div>
        <div>
          <h3 class="label">{t.experience.distinctionsTitle}</h3>
          <ul class="mt-3 divide-y divide-rule text-sm leading-relaxed">
            {t.experience.distinctions.map((d) => <li class="py-2.5 first:pt-0">{d}</li>)}
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>
